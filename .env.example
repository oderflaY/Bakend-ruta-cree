# Copia a .env y ajusta. Los secretos NO van aquí: están en ./secrets (scripts/generar-secretos.sh).

# Administrador inicial (se crea solo si no existe ninguno). Su contraseña: secrets/admin_password
ADMIN_EMAIL=admin@rutacree.mx

# Puerto del API en el host. 0.0.0.0 para probar con el teléfono en la misma red Wi-Fi;
# en producción usa 127.0.0.1 y el perfil https (Caddy).
API_BIND=0.0.0.0
API_PORT=8080

# El panel de control se sirve en http(s)://servidor/panel/ desde el mismo origen que el API, así que
# no necesita estar aquí. Solo agrega orígenes si abres el panel desde otro lado (coma separada).
ALLOWED_ORIGINS=

# Carpeta del panel (Frontend admin). En el paquete del VPS va en ./panel y no hace falta tocarlo;
# en desarrollo apunta a la carpeta del panel.
# PANEL_SRC=../Frontend admin

# Días que se conserva el historial de posiciones.
POSITION_RETENTION_DAYS=30

# Solo para el perfil https: dominio público apuntando a este servidor.
# DOMAIN=api.rutacree.mx

# Traccar (GPS del teléfono del chofer). Cuenta de servicio del API y de la web de Traccar (:8082);
# su contraseña está en secrets/traccar_password.
TRACCAR_EMAIL=traccar@rutacree.mx
# Dirección que el chofer escribe en Traccar Client ("URL del servidor"), vista desde el teléfono.
TRACCAR_PUBLIC_OSMAND_URL=http://192.168.1.10:5055
# Puertos publicados: OsmAnd (teléfonos) y la web de Traccar. En producción pon la web en 127.0.0.1.
TRACCAR_OSMAND_PORT=5055
TRACCAR_WEB_PORT=8082

# WhatsApp del despacho (lada de país + número, solo dígitos; México: 52 + 10 dígitos). La app del
# chofer abre WhatsApp con el aviso listo para mandar ahí: inicio y fin de ruta, fallas del camión y
# de la rampa. Vacío: WhatsApp le deja elegir el chat o grupo.
WHATSAPP_DESPACHO=
